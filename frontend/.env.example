# Copy this file to .env for local dev (optional — it already defaults to
# http://localhost:5000/api when this var is unset).
#
# In the Vercel dashboard, set this as an Environment Variable on the
# FRONTEND project: Settings -> Environment Variables -> VITE_API_URL
# Value = the deployed backend's URL + /api, e.g.:
# https://your-backend-project.vercel.app/api
VITE_API_URL=http://localhost:5000/api
