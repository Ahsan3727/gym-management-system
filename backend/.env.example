# Copy this file to .env and fill in real values before running the server.

# MongoDB connection string (local install or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/gym_management

# Server port
PORT=5000

# JWT secret - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=15m

# CORS - the URL your frontend runs on.
# Locally: http://localhost:5173
# In production (Vercel): set this to your deployed FRONTEND url, e.g.
# https://your-frontend-project.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Vercel Cron Secret (optional locally, recommended for production cron security)
CRON_SECRET=replace_with_a_secure_random_cron_secret

# Transactional Email via Nodemailer (optional - app gracefully logs warnings if not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
FROM_EMAIL=noreply@ironlinegym.com
FROM_NAME=Ironline Gym

# Cloudinary Storage for Logos & Progress Photos (optional - inline data URI fallback if not configured)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe Payment Processing (optional - simulates checkouts if omitted)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret

# NOTE for Vercel: set MONGO_URI, JWT_SECRET, CLIENT_ORIGIN, etc.
# as Environment Variables on the project in the Vercel dashboard.
# MONGO_URI must point at a reachable database — MongoDB Atlas (free tier works great).

# Used once by `npm run seed` to create the first Super Admin account
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=ChangeMe123!
